generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum GroupInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password                   String
  bio                        String?
  profilePicture             String?   @default("/account.png")
  resetToken                 String?
  resetTokenExpiresAt        DateTime?
  lastResetTokenSentAt       DateTime?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  lastVerificationSentAt     DateTime?
  code                       String?
  createdAt                  DateTime  @default(now())

  posts     Post[]
  likes     Like[]
  bookmarks Bookmark[]

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  contacts Contact[] @relation("UserContacts")
  friends  Contact[] @relation("FriendContacts")

  sentMessages     ContactMessage[] @relation("SentContactMessages")
  receivedMessages ContactMessage[] @relation("ReceivedContactMessages")

  createdCalls Call[]         @relation("CallCreator")
  allowedCalls UsersAllowed[]

  groupsCreated Group[]       @relation("GroupCreator")
  groupMembers  GroupMember[]

  sentGroupInvitations     GroupInvitation[] @relation("GroupInvitationSender")
  receivedGroupInvitations GroupInvitation[] @relation("GroupInvitationReceiver")
}

model Call {
  id             String  @id @default(uuid())
  creatorId      String
  isCallFinished Boolean @default(false)

  creator      User           @relation("CallCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  allowedUsers UsersAllowed[]
}

model UsersAllowed {
  id     String @id @default(uuid())
  userId String
  callId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([userId, callId])
}

model FriendRequest {
  id         String        @id @default(uuid())
  senderId   String
  receiverId String
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id])
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id])

  @@unique([senderId, receiverId])
}

model Contact {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("UserContacts", fields: [userId], references: [id])
  friend User @relation("FriendContacts", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model ContactMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String?
  image      String?
  voice      String?
  createdAt  DateTime @default(now())

  sender   User @relation("SentContactMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedContactMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
}

model Post {
  id        String   @id @default(uuid())
  content   String
  image     String
  createdAt DateTime @default(now())
  authorId  String

  author    User       @relation(fields: [authorId], references: [id])
  likes     Like[]
  bookmarks Bookmark[]
}

model Like {
  id     String @id @default(uuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Bookmark {
  id     String @id @default(uuid())
  userId String
  postId String

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Group {
  id        String   @id @default(uuid())
  name      String
  image     String?
  creatorId String
  createdAt DateTime @default(now())

  creator     User              @relation("GroupCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  invitations GroupInvitation[]
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupInvitation {
  id         String                @id @default(uuid())
  groupId    String
  senderId   String
  receiverId String
  status     GroupInvitationStatus @default(PENDING)
  createdAt  DateTime              @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  sender User @relation("GroupInvitationSender", fields: [senderId], references: [id], onDelete: Cascade)

  receiver User @relation("GroupInvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([groupId, receiverId])
}
